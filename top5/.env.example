# Copy to .env for `netlify dev`. Never commit the real .env.
SITE_URL=http://localhost:8888

# PayPal (Developer Dashboard > Apps & Credentials, Sandbox tab while testing)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Admin
ADMIN_PASSWORD=
# 32+ random characters, e.g. `openssl rand -hex 32`
ADMIN_SESSION_SECRET=

# Optional: "edition" (default) or "forever"
ACCESS_MODE=edition
# Optional: days buyers keep access after their edition is replaced (default 30)
ACCESS_GRACE_DAYS=30
